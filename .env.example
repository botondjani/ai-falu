# LLM-szolgáltató: gemini (alap) vagy anthropic. Kulcs nélkül mock mód (költség nélkül).
LLM_PROVIDER=gemini
GEMINI_API_KEY=
# ANTHROPIC_API_KEY=

# LLM (alapértékek)
# könnyű feladatok (terv, döntés, beszélgetés) és nehezebbek (reflexió, összefoglaló, Isten-mód)
LLM_MODEL_ROUTINE=gemini-2.5-flash-lite
LLM_MODEL_STRONG=gemini-2.5-flash
# keretek: össz. $ / futás, valós napi $, hívás / szimulált nap
LLM_MAX_USD_TOTAL=5
LLM_MAX_USD_PER_DAY=2
LLM_MAX_CALLS_PER_SIM_DAY=600
# keret elérésekor: pause (szünet) vagy autopilot (LLM nélkül tovább)
LLM_ON_BUDGET=pause
# LLM-mel döntő lakók: vesszős lista vagy all
SIM_LLM_AGENTS=all

# Szimuláció
SIM_SEED=falu
SIM_PORT=8787
# valós másodperc / szimulált nap (600 = 10 perc)
SIM_SECONDS_PER_DAY=600

# Viewer (Vite) – ha a szimuláció máshol fut
# VITE_SIM_WS=ws://localhost:8787
