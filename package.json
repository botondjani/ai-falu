{
  "name": "falu",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "sim": "tsx packages/sim/src/cli.ts",
    "viewer": "npm -w @falu/viewer run dev",
